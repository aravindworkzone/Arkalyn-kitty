{
  "id": "/",
  "name": "Arkalyn Kitty",
  "short_name": "Arkalyn",
  "description": "Track shared expenses, credits and chit funds with your groups.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/groups",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
